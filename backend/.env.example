# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=valory

# Gemini (embeddings) - https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (LLM fallback) - https://console.groq.com/keys (free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Resolution thresholds (tune after seeing real scores on your data)
EMBEDDING_AUTO_MERGE_THRESHOLD=0.88
EMBEDDING_AMBIGUOUS_FLOOR=0.75
